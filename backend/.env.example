# ---------------------------------------------------------------------------
# 校园「今天吃什么」后端环境变量样例
# 用法：cp .env.example .env，按需改值；.env 已在 .gitignore 里，不要提交。
# 系统里真实存在的环境变量优先级高于 .env。
# ---------------------------------------------------------------------------

# dev | prod —— 决定加载 config.settings_dev 还是 config.settings_prod
DJANGO_ENV=dev

# 必填：生产环境不设置会直接启动失败。生成方式（二选一）：
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
#   openssl rand -base64 64
SECRET_KEY=dev-only-please-change-me-in-production

# 开发默认 True；生产会被 settings_prod 强制为 False
DEBUG=True

# 逗号分隔。开发环境（settings_dev）会自动放开全部 hosts
ALLOWED_HOSTS=127.0.0.1,localhost

# ---------------------------------------------------------------------------
# 数据库：sqlite（默认，零安装） | mysql
# ---------------------------------------------------------------------------
DB_ENGINE=sqlite
# SQLite 文件位置，默认 backend/db.sqlite3
# DB_SQLITE_PATH=./db.sqlite3

# 以下仅 DB_ENGINE=mysql 时生效
# DB_NAME=what2eat
# DB_USER=root
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_CONN_MAX_AGE=60

# ---------------------------------------------------------------------------
# 跨域：前端 Vite 默认 5173
# ---------------------------------------------------------------------------
# 开发环境默认放开全部来源；生产必须显式配置白名单
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# CORS_ALLOW_ALL_ORIGINS=True
# CSRF_TRUSTED_ORIGINS=https://your-frontend.example.com

# ---------------------------------------------------------------------------
# JWT 有效期
# ---------------------------------------------------------------------------
JWT_ACCESS_MINUTES=120
JWT_REFRESH_DAYS=7

# ---------------------------------------------------------------------------
# 业务参数
# ---------------------------------------------------------------------------
# 随机推荐：排除最近 N 条打卡；权重 = BASE + 热度 * HEAT
RECOMMEND_RECENT_LIMIT=4
RECOMMEND_WEIGHT_BASE=1.0
RECOMMEND_WEIGHT_HEAT=0.06

# 投票默认时长（小时）与目标人数区间
VOTE_DEFAULT_HOURS=12
VOTE_TARGET_COUNT_MIN=2
VOTE_TARGET_COUNT_MAX=99

# 举报达到 N 次自动禁言（小时）
AUTO_MUTE_REPORT_COUNT=5
AUTO_MUTE_HOURS=24

# ---------------------------------------------------------------------------
# 上传 / 媒体（图片先落本地，生产可换对象存储）
# ---------------------------------------------------------------------------
IMAGE_MAX_BYTES=5242880
MEDIA_URL=/media/
# MEDIA_ROOT=./media

# ---------------------------------------------------------------------------
# 其他
# ---------------------------------------------------------------------------
API_PAGE_SIZE=10
TIME_ZONE=Asia/Shanghai
LOG_LEVEL=INFO
# SQL 调试：DB_LOG_SQL=1
