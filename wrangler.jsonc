{
  // Cloudflare Workers 部署配置：把一个纯静态站点作为 Worker 的静态资源发布
  // 本地不要改 name，它必须和 Cloudflare 上的项目名一致
  "name": "what2eat",
  "compatibility_date": "2025-06-01",

  "assets": {
    // 构建产物目录，和 Vite 的 outDir 一致
    "directory": "./dist",
    // 关键：所有找不到的路径都回退到 index.html，等价于 SPA 路由
    // 没有这行，直接访问 /vote、/me 会 404
    "not_found_handling": "single-page-application"
  }
}
